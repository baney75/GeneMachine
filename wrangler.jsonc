{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genemachine",
  // GeneMachine is hosted in Donovan's Personal Cloudflare account.
  "account_id": "b37d692c5e869dde568286039d125fd7",
  "compatibility_date": "2026-10-02",
